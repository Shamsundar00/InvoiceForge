// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id               String   @id @default(cuid())
  fileName         String
  filePath         String
  originalFileHash String?
  uploadDate       DateTime @default(now())
  rowCount         Int      @default(0)
  columnCount      Int      @default(0)
  columnMapping    String?  @db.Text // JSON
  validationStatus String   @default("pending") // pending, passed, warnings, errors
  validationReport String?  @db.Text // JSON
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  invoices          Invoice[]
  generationHistory GenerationHistory[]
}

model Invoice {
  id                String   @id @default(cuid())
  invoiceNumber     String
  revisionNumber    Int      @default(0)
  parentInvoiceId   String?
  parentInvoice     Invoice?  @relation("InvoiceRevisions", fields: [parentInvoiceId], references: [id])
  childRevisions    Invoice[] @relation("InvoiceRevisions")
  sourceId          String?
  source            Source?   @relation(fields: [sourceId], references: [id])
  sourceRowIndex    Int?
  customerFirstName String?
  customerLastName  String?
  category          String?
  subtotal          Float     @default(0)
  discountAmount    Float     @default(0)
  taxRate           Float     @default(0)
  taxAmount         Float     @default(0)
  totalAmount       Float     @default(0)
  costPrice         Float?
  marginAmount      Float?
  marginPercentage  Float?
  aiDescription     String?   @db.Text
  templateId        String?
  template          Template? @relation(fields: [templateId], references: [id])
  languageCode      String    @default("en")
  qrData            String?   @db.Text // JSON
  qrVerificationHash String?
  invoiceDate       DateTime  @default(now())
  generatedDate     DateTime  @default(now())
  filePath          String?
  status            String    @default("draft") // draft, generated, error, superseded
  revisionReason    String?
  isCurrentVersion  Boolean   @default(true)
  rawData           String?   @db.Text // JSON - original row data
  batchId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Template {
  id                  String   @id @default(cuid())
  name                String
  category            String?
  isPreset            Boolean  @default(false)
  isCustom            Boolean  @default(false)
  layoutConfig        String?  @db.Text // JSON - full template configuration
  defaultLanguageCode String   @default("en")
  qrEnabled           Boolean  @default(false)
  qrPosition          String   @default("bottom-right")
  qrSize              String   @default("medium")
  thumbnailPath       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  invoices          Invoice[]
  generationHistory GenerationHistory[]
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String   @default("general") // general, ai, tax, branding, financial_year, backup
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GenerationHistory {
  id              String   @id @default(cuid())
  batchId         String   @unique
  sourceId        String?
  source          Source?  @relation(fields: [sourceId], references: [id])
  templateId      String?
  template        Template? @relation(fields: [templateId], references: [id])
  totalInvoices   Int      @default(0)
  successfulCount Int      @default(0)
  errorCount      Int      @default(0)
  totalRevenue    Float    @default(0)
  totalProfit     Float?
  aiTokensUsed    Int      @default(0)
  aiCostEstimate  Float    @default(0)
  generationDate  DateTime @default(now())
  exportFormat    String?
  exportFilePath  String?
  auditFilePath   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AuditLog {
  id               String   @id @default(cuid())
  timestamp        DateTime @default(now())
  actionType       String   // upload, generate, export, revise, delete, backup, restore, settings_change
  actionDetail     String?  @db.Text
  user             String   @default("admin")
  affectedEntity   String?  // source, invoice, template, setting
  affectedEntityId String?
  metadata         String?  @db.Text // JSON
  createdAt        DateTime @default(now())
}

model Backup {
  id            String   @id @default(cuid())
  fileName      String
  filePath      String
  fileSizeBytes Int      @default(0)
  createdDate   DateTime @default(now())
  type          String   @default("manual") // manual, scheduled
  checksum      String?
  appVersion    String   @default("1.1.0")
  invoiceCount  Int      @default(0)
  templateCount Int      @default(0)
  sourceCount   Int      @default(0)
  status        String   @default("completed") // completed, failed, in_progress
  createdAt     DateTime @default(now())
}

model LanguagePack {
  id           String   @id @default(cuid())
  languageCode String   @unique
  languageName String
  isPreset     Boolean  @default(false)
  labels       String   @db.Text // JSON - key-value pairs
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Branding {
  id                  String   @id @default(cuid())
  appName             String   @default("InvoiceForge")
  logoPath            String?
  faviconPath         String?
  primaryColor        String   @default("#6366F1")
  loginBackgroundPath String?
  footerText          String   @default("Powered by InvoiceForge")
  welcomeMessage      String   @default("Welcome back!")
  updatedAt           DateTime @updatedAt
}

model FinancialYearConfig {
  id                    String   @id @default(cuid())
  startMonth            Int      @default(4) // April for India
  currentFyLabel        String   @default("2025-26")
  currentSequenceNumber Int      @default(1)
  numberingFormat       String   @default("{PREFIX}-{FY}-{NUMBER}")
  prefix                String   @default("INV")
  zeroPaddingLength     Int      @default(4)
  lastResetDate         DateTime? 
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
